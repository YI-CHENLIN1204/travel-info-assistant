POSTGRES_DB=travel_info
POSTGRES_USER=travel_app
POSTGRES_PASSWORD=change-me-before-deployment
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080
WEB_PORT=5173

# Frontend: leave empty to run as a normal browser app during local development.
VITE_LIFF_ID=
VITE_API_BASE_URL=/api

# Active provider. Register a TDX basic account and never commit real values.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# Global flights. RapidAPI has a free plan; subscribe to AeroDataBox first, then paste the key.
AERODATABOX_GATEWAY=RapidApi
AERODATABOX_BASE_URL=https://aerodatabox.p.rapidapi.com/
AERODATABOX_API_KEY=
AERODATABOX_BILLING_CYCLE_DAY=1
AERODATABOX_MONTHLY_SOFT_LIMIT_UNITS=360
AERODATABOX_MONTHLY_HARD_LIMIT_UNITS=400
AERODATABOX_MONTHLY_TRAFFIC_SOFT_LIMIT_BYTES=9000000000
AERODATABOX_REQUESTS_PER_SECOND=1

# Weather. MET Norway requires a unique User-Agent with real contact information.
METNORWAY_USER_AGENT=TravelInfoAssistant/0.1 https://github.com/YI-CHENLIN1204/travel-info-assistant

# Reserved for later overseas integrations.
ODPT_CONSUMER_KEY=
